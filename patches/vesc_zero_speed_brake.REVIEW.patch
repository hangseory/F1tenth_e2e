 void VescDriver::speedCallback(const Float64::SharedPtr speed)
 {
   if (driver_mode_ == MODE_OPERATING) {
-    vesc_.setSpeed(speed_limit_.clip(speed->data));
+    const double rpm = speed_limit_.clip(speed->data);
+    Float64 brake;
+    // One serial command per callback: brake or speed, never competing publishers.
+    // Brake current magnitude opposes either direction of rotation inside the VESC.
+    if (!std::isfinite(rpm) || (zero_speed_brake_current_ > 0.0 && std::abs(rpm) < 1e-6)) {
+      brake.data = brake_limit_.clip(zero_speed_brake_current_);
+      vesc_.setBrake(brake.data);
+    } else {
+      brake.data = 0.0;
+      vesc_.setSpeed(rpm);
+    }
